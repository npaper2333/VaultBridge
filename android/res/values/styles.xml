        <item name="android:colorControlNormal">#757575</item>
        <item name="android:colorControlActivated">#e5e5e5</item>
        <item name="android:colorControlHighlight">#20a8a8a8</item>
        <item name="android:colorButtonNormal">#2c2c2c</item>
        <item name="android:scrollbarThumbVertical">@drawable/scroll_thumb</item>
